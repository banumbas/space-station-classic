uniform sampler2D SCREEN_TEXTURE;
uniform highp vec3 BLUR_COLOR;

const highp float darken_strength = 0.3; // Darkness level 0.0 to 1.0
const highp float blur_radius = 2.0; // Blur radius from 0.0 to 10.0

void fragment() {
    // SCREEN_TEXTURE is nearest-filtered, so use a five-fetch cross instead of relying on bilinear taps.
    highp vec2 sample_offset = SCREEN_PIXEL_SIZE * blur_radius;
    highp vec4 blurred_color = texture(SCREEN_TEXTURE, UV) * 4.0;
    blurred_color += texture(SCREEN_TEXTURE, UV + vec2(sample_offset.x, 0.0));
    blurred_color += texture(SCREEN_TEXTURE, UV - vec2(sample_offset.x, 0.0));
    blurred_color += texture(SCREEN_TEXTURE, UV + vec2(0.0, sample_offset.y));
    blurred_color += texture(SCREEN_TEXTURE, UV - vec2(0.0, sample_offset.y));
    blurred_color *= 0.125;

    highp vec3 shadow = mix(vec3(1.0), BLUR_COLOR, darken_strength);
    blurred_color.rgb *= shadow;

    COLOR = blurred_color;
}
